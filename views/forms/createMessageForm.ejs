<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Message</title>
    <link rel="stylesheet" href="/main.css" />
    <link rel="stylesheet" href="/form.css" />
    <link rel="stylesheet" href="/header.css" />
    <link rel="stylesheet" href="/footer.css" />

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
  </head>
  <body>
    <%- include('../partials/header.ejs') %>

    <h1 class="create-message__title">Create message</h1>
    <form class="form" action="/messages" method="POST">
      <a class="back" href="javascript:history.back()">
        <i data-lucide="arrow-left" class="arrow"></i>
        <span>Back</span>
      </a>
      <div class="form-section">
        <label for="title">Title</label>
        <input type="text" name="title" id="title" placeholder="Great day" />
      </div>

      <div class="form-section">
        <label for="content">Content</label>
        <textarea
          name="content"
          id="content"
          placeholder="Today I had a great day..."
          rows="10"
        ></textarea>
      </div>

      <button class="form-btn" type="submit">Create</button>
    </form>

    <%- include('../partials/footer.ejs') %>
  </body>
  <script>
    lucide.createIcons();
  </script>
</html>
